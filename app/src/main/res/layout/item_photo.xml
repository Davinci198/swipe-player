<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF050507">

    <!-- Poză full-screen, cu ZOOM in/out (pinch) + pan; se afișează COMPLET (fitCenter),
         fără trunchiere - barele negre apar doar la proporții diferite de ecran -->
    <com.swipe.player.ZoomableImageView
        android:id="@+id/imgPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="Poza" />

    <!-- Spinner de încărcare peste poză, ascuns după decode -->
    <ProgressBar
        android:id="@+id/imgLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:layout_gravity="center" />
</FrameLayout>