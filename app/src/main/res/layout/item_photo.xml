<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF050507">

    <!-- Poză full-screen, cu ZOOM in/out (pinch) + pan; centerCrop la încărcare -->
    <com.swipe.player.ZoomableImageView
        android:id="@+id/imgPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Poza" />

    <!-- Spinner de încărcare peste poză, ascuns după decode -->
    <ProgressBar
        android:id="@+id/imgLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:layout_gravity="center" />

    <!-- Creionul pentru REDENUMIRE poză (colț dreapta sus) -->
    <ImageButton
        android:id="@+id/imgRenameBtn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_settings"
        android:src="@drawable/ic_pencil"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:contentDescription="Redenumește poza" />
</FrameLayout>