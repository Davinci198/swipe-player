<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF050507">

    <!-- Pager VIDEOCLIPURI (swipe vertical). Folosește marginile stânga/dreapta pentru luminozitate/volum. -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Pager POZE (swipe vertical). Marginea de jos = înălțimea panoului foto (miniaturi + controale). -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/imagePager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="136dp"
        android:visibility="gone" />

    <!-- Header: comutator mod (Video / Poze) + status -->
    <LinearLayout
        android:id="@+id/headerOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_overlay">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#33FFFFFF"
            android:padding="6dp">
            <TextView
                android:id="@+id/modeVideoBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬 Video"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="#33FFFFFF" />
            <TextView
                android:id="@+id/modePhotoBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖼️ Poze"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alege fișiere din ⚙️ Setări"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Creion REDENUMIRE poză: în dreapta, SUB butonul de setări, ca să NU se suprapună.
         Se ascunde automat după 3s în modul Poze. -->
    <ImageButton
        android:id="@+id/photoRenameBtn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_settings"
        android:src="@drawable/ic_pencil"
        android:scaleType="centerInside"
        android:padding="9dp"
        android:contentDescription="Redenumește poza"
        android:visibility="gone" />

    <!-- Panoul FOTO (jos, doar modul Poze): controale (luminozitate/volum, auto-hide) + miniaturi -->
    <LinearLayout
        android:id="@+id/photoBottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#E60A0A0D"
        android:visibility="gone">

        <!-- Rând controale luminozitate + volum (se ascunde automat după 3s, revine la tap pe miniaturi) -->
        <LinearLayout
            android:id="@+id/photoControlsBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️"
                android:textSize="16sp" />
            <SeekBar
                android:id="@+id/photoBrightnessSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:max="1000" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="🔊"
                android:textSize="16sp" />
            <SeekBar
                android:id="@+id/photoVolumeSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:max="1000" />
        </LinearLayout>

        <!-- Miniaturi pentru navigare rapidă, persistente -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/photoThumbStrip"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clipToPadding="false"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- Buton setari: colț dreapta sus -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:contentDescription="Setări"
        android:background="@drawable/bg_settings"
        android:src="@android:drawable/ic_menu_manage"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:elevation="8dp"
        android:alpha="0.92" />
</FrameLayout>