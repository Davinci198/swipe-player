<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08080A">

    <!-- Aici vine ViewPager2 / PlayerView existent -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay stanga BRIGHTNESS -->
    <FrameLayout
        android:id="@+id/brightnessOverlay"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_glass_neon"
        android:visibility="gone"
        android:elevation="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_brightness"
                android:tint="#FF2A3D" />

            <ProgressBar
                android:id="@+id/brightnessProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="80dp"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="50"
                android:progressTint="#FF2A3D"
                android:progressBackgroundTint="#FFFFFF14" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="BRIGHTNESS"
                android:textColor="#FFFFFF60"
                android:textSize="9sp"
                android:letterSpacing="0.15" />
        </LinearLayout>
    </FrameLayout>

    <!-- Overlay dreapta VOLUME -->
    <FrameLayout
        android:id="@+id/volumeOverlay"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_glass_neon"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_volume"
                android:tint="#FF2A3D" />

            <ProgressBar
                android:id="@+id/volumeProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="80dp"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="50"
                android:progressTint="#FF2A3D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="VOLUME"
                android:textColor="#FFFFFF60"
                android:textSize="9sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Overlay centru SEEK + thumbnail preview -->
    <FrameLayout
        android:id="@+id/seekOverlay"
        android:layout_width="200dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_glass_neon"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/seekPreview"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#0E0E10" />

        <TextView
            android:id="@+id/seekText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:text="+10s"
            android:textColor="white"
            android:textSize="13sp"
            android:fontFamily="monospace" />
    </FrameLayout>

    <!-- Timeline neon chapters -->
    <com.swipe.player.TimelineChaptersView
        android:id="@+id/timelineView"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="16dp" />

</FrameLayout>
