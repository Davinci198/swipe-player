<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF050507">

    <!-- Pager VIDEOCLIPURI (swipe vertical). Folosește marginile stânga/dreapta pentru luminozitate/volum. -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Pager POZE (swipe vertical). Sus cu o margine jos ca să NU se suprapună peste bara de control foto. -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/imagePager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="76dp"
        android:visibility="gone" />

    <!-- Header: compact, cu comutator mod (Video / Poze) + status.
         Butonul de alegere fișiere a fost mutat în Setări. -->
    <LinearLayout
        android:id="@+id/headerOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_overlay">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#33FFFFFF"
            android:padding="6dp">
            <TextView
                android:id="@+id/modeVideoBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬 Video"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="#33FFFFFF" />
            <TextView
                android:id="@+id/modePhotoBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖼️ Poze"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alege fișiere din ⚙️ Setări"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Bara de control FOTO (jos): luminozitate (stânga) + volum (dreapta).
         Vizibilă DOAR în modul Poze; nu se suprapune peste poze (pagerul are margine jos). -->
    <LinearLayout
        android:id="@+id/photoControlsBar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#EE111116"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/photoBrightnessSeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:text="🔊"
            android:textSize="18sp" />

        <SeekBar
            android:id="@+id/photoVolumeSeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000" />
    </LinearLayout>

    <!-- Buton setari: colț dreapta sus, sub header -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:contentDescription="Setări"
        android:background="@drawable/bg_settings"
        android:src="@android:drawable/ic_menu_manage"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:elevation="8dp"
        android:alpha="0.92" />
</FrameLayout>