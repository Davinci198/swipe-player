<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF050507">

    <!-- Pager VIDEOCLIPURI (swipe vertical) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Pager POZE (swipe vertical, separat de video) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/imagePager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Header: compact, cu comutator mod (Video / Poze) + status.
         Butonul de alegere fișiere a fost mutat în Setări. -->
    <LinearLayout
        android:id="@+id/headerOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_overlay">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#33FFFFFF"
            android:padding="6dp">
            <TextView
                android:id="@+id/modeVideoBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎬 Video"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="#33FFFFFF" />
            <TextView
                android:id="@+id/modePhotoBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖼️ Poze"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alege fișiere din ⚙️ Setări"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Buton setari: colț stânga sus, sub header -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:contentDescription="Setări"
        android:background="@drawable/bg_settings"
        android:src="@android:drawable/ic_menu_manage"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:elevation="8dp"
        android:alpha="0.92" />
</FrameLayout>