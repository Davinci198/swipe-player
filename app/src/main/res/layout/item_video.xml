<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. PlayerView - FIX: fit în loc de zoom -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit"
        app:surface_type="texture_view"
        app:shutter_background_color="#000000" />

    <!-- 1b. Overlay dim -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="false"
        android:focusable="false"
        android:visibility="invisible" />

    <!-- 2. Loading -->
    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="false"
        android:focusable="false"
        android:elevation="1dp">
        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading video..."
            android:textColor="#99FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- Brightness -->
    <FrameLayout
        android:id="@+id/brightnessIndicator"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:paddingStart="16dp"
        android:paddingTop="90dp"
        android:paddingBottom="90dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/brightnessTrack"
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="bottom"
            android:background="@drawable/indicator_track">
            <View
                android:id="@+id/brightnessFill"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/indicator_fill" />
        </LinearLayout>
    </FrameLayout>

    <!-- Volume -->
    <FrameLayout
        android:id="@+id/volumeIndicator"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:paddingEnd="16dp"
        android:paddingTop="90dp"
        android:paddingBottom="90dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/volumeTrack"
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="bottom"
            android:background="@drawable/indicator_track">
            <View
                android:id="@+id/volumeFill"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/indicator_fill" />
        </LinearLayout>
    </FrameLayout>

    <!-- Seek -->
    <LinearLayout
        android:id="@+id/seekIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="64dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/seekTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00 / 0:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:shadowColor="#000000"
            android:shadowRadius="4" />
        <ProgressBar
            android:id="@+id/seekProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:max="1000" />
    </LinearLayout>

    <!-- Touch catcher -->
    <View
        android:id="@+id/touch_catcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp" />

    <TextView
        android:id="@+id/tvVideoName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:elevation="11dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:shadowColor="#000000"
        android:shadowRadius="4" />
    <ImageButton
        android:id="@+id/btnFavorite"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="20dp"
        android:elevation="11dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@android:drawable/btn_star_big_off" />

    <ImageButton
        android:id="@+id/btnSeekBack"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="12dp"
        android:elevation="20dp"
        android:background="@drawable/seek_btn_bg"
        android:scaleType="fitCenter"
        android:contentDescription="Înapoi"
        android:src="@android:drawable/ic_media_rew" />
    <ImageButton
        android:id="@+id/btnSeekFwd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="12dp"
        android:elevation="20dp"
        android:background="@drawable/seek_btn_bg"
        android:scaleType="fitCenter"
        android:content
