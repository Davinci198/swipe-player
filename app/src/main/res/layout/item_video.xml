<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF050507"
    android:fitsSystemWindows="false"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 1. PlayerView (video) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        android:clickable="false"
        android:focusable="false"
        app:resize_mode="fit" />

    <!-- 1b. Overlay de attenuire (dim) pt luminozitate: fallback vizibil cand
         window.screenBrightness e blocat pe Motorola fara WRITE_SETTINGS.
         Alpha controlat din cod; DEDESUBT touch_catcher. -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="false"
        android:focusable="false"
        android:visibility="invisible" />

    <!-- 2. Loading - DEASUPRA video, DEDESUBT touch_catcher.
         clickable=false ca sa nu-si insuseasca touch; elevatie mica. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:id="@+id/loadingContainer"
        android:clickable="false"
        android:focusable="false"
        android:elevation="1dp">
        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading video..."
            android:textColor="#99FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- Indicator luminozitate (fallback vizual, stânga): bara verticală umplută cu alb
         după nivel (0..1). Vizibil doar în timpul swipe-ului vertical pe stânga. -->
    <FrameLayout
        android:id="@+id/brightnessIndicator"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:paddingStart="16dp"
        android:paddingTop="90dp"
        android:paddingBottom="90dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/brightnessTrack"
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="bottom"
            android:background="@drawable/indicator_track">
            <View
                android:id="@+id/brightnessFill"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/indicator_fill" />
        </LinearLayout>
    </FrameLayout>

    <!-- Indicator volum (fallback vizual, dreapta): bara verticală umplută după nivel. -->
    <FrameLayout
        android:id="@+id/volumeIndicator"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:paddingEnd="16dp"
        android:paddingTop="90dp"
        android:paddingBottom="90dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/volumeTrack"
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="bottom"
            android:background="@drawable/indicator_track">
            <View
                android:id="@+id/volumeFill"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/indicator_fill" />
        </LinearLayout>
    </FrameLayout>

    <!-- Indicator seek (derulare stânga/dreapta): bară orizontală jos + timp curent. -->
    <LinearLayout
        android:id="@+id/seekIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="64dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/seekTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00 / 0:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:shadowColor="#000000"
            android:shadowRadius="4" />
        <ProgressBar
            android:id="@+id/seekProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:max="1000" />
    </LinearLayout>

    <!-- 3. Perdea/touch_catcher: ULTIMUL strat full-screen, DEASUPRA video si loading.
         clickable + focusable + elevation => asigura primirea touch pe Stock/Motorola.
         Ramane DEDESUBT nume si buton fav (declarate mai jos). -->
    <View
        android:id="@+id/touch_catcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:focusable="false"
        android:elevation="10dp" />

    <!-- Nume videoclip + buton fav: declarate DUPĂ touch_catcher => deasupra lui
         (FrameLayout desenează ultimul copil în față), elevation 11dp pt siguranță. -->
    <TextView
        android:id="@+id/tvVideoName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:elevation="11dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:shadowColor="#000000"
        android:shadowRadius="4" />
    <ImageButton
        android:id="@+id/btnFavorite"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="20dp"
        android:elevation="11dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@android:drawable/btn_star_big_off" />

    <!-- Butoane de derulare rapidă ⏪/⏩ (pas = N secunde configurat în Setări).
         Poziționate pe laturi la vertical-mijloc, SUS de zona nume-video/controller,
         ca să NU se suprapună. Elevation mare (>11dp) ca să prindă click-urile peste
         touch_catcher (10dp). -->
    <ImageButton
        android:id="@+id/btnSeekBack"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="12dp"
        android:elevation="20dp"
        android:background="@drawable/seek_btn_bg"
        android:scaleType="fitCenter"
        android:contentDescription="Înapoi"
        android:src="@android:drawable/ic_media_rew" />
    <ImageButton
        android:id="@+id/btnSeekFwd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="12dp"
        android:elevation="20dp"
        android:background="@drawable/seek_btn_bg"
        android:scaleType="fitCenter"
        android:contentDescription="Înainte"
        android:src="@android:drawable/ic_media_ff" />

    <!-- ============================================================
         GESTURE INTERCEPT + OVERLAY-URI NEON (design #08080A / #FF2A3D)
         touchIntercept: strat transparent DUPĂ playerView (vizual), clickable+focusable
         ca să primească touch-ul peste PlayerView (care are use_controller=false).
         Cele 2 overlay-uri sunt 48dp x 180dp, centrate vertical pe stânga/dreapta,
         cu ProgressBar orizontal rotit -90 (=> afișat vertical) și iconiță jos.
         ============================================================ -->
    <View
        android:id="@+id/touchIntercept"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <!-- Overlay BRIGHTNESS (stânga): pill sticlă 64dp x 220dp, iconiță galbenă SUS,
         bară verticală GALBENĂ, procent alb JOS (ca în demo) -->
    <LinearLayout
        android:id="@+id/brightnessOverlay"
        android:layout_width="64dp"
        android:layout_height="220dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="20dp"
        android:background="@drawable/bg_overlay_dark"
        android:visibility="gone"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:elevation="30dp">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_brightness"
            android:tint="#FFC107" />
        <ProgressBar
            android:id="@+id/brightnessProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="130dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:rotation="-90"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/neon_progress_amber" />
        <TextView
            android:id="@+id/brightnessPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Overlay VOLUME (dreapta): pill sticlă 64dp x 220dp, iconiță roșie SUS,
         bară verticală ROȘIE, procent alb JOS (ca în demo) -->
    <LinearLayout
        android:id="@+id/volumeOverlay"
        android:layout_width="64dp"
        android:layout_height="220dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_overlay_dark"
        android:visibility="gone"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:elevation="30dp">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_volume"
            android:tint="#FF2A3D" />
        <ProgressBar
            android:id="@+id/volumeProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="130dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:rotation="-90"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/neon_progress_ff2a3d" />
        <TextView
            android:id="@+id/volumePct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>