<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08080A">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:use_controller="false"
        app:controller_layout_id="@layout/exo_controller_view" />

    <!-- Dim pentru brightness -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0"
        android:visibility="gone" />

    <!-- Touch catcher - PRINDE toate gesturile -->
    <View
        android:id="@+id/touch_catcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- VIDEO NAME TOP -->
    <TextView
        android:id="@+id/tvVideoName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:background="#33000000"
        android:padding="6dp"
        android:visibility="gone" />

    <!-- FAVORITE -->
    <ImageButton
        android:id="@+id/btnFavorite"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_favorite_border"
        android:visibility="gone" />

    <!-- ===== BRIGHTNESS INDICATOR - STANGA - NEON #FF2A3D ===== -->
    <FrameLayout
        android:id="@+id/brightnessIndicator"
        android:layout_width="56dp"
        android:layout_height="112dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="24dp"
        android:background="@drawable/overlay_neon_bg"
        android:visibility="gone"
        android:elevation="10dp">

        <View
            android:id="@+id/brightnessFill"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="bottom"
            android:background="#FF2A3D" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_brightness_6"
            android:tint="#FFFFFF" />
    </FrameLayout>

    <!-- ===== VOLUME INDICATOR - DREAPTA - NEON #FF2A3D ===== -->
    <FrameLayout
        android:id="@+id/volumeIndicator"
        android:layout_width="56dp"
        android:layout_height="112dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="24dp"
        android:background="@drawable/overlay_neon_bg"
        android:visibility="gone"
        android:elevation="10dp">

        <View
            android:id="@+id/volumeFill"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="bottom"
            android:background="#FF2A3D" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_volume_up"
            android:tint="#FFFFFF" />
    </FrameLayout>

    <!-- ===== SEEK INDICATOR - CENTRU - NEON ===== -->
    <LinearLayout
        android:id="@+id/seekIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/overlay_neon_bg"
        android:padding="16dp"
        android:visibility="gone"
        android:elevation="10dp">

        <TextView
            android:id="@+id/seekTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+10s"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-black" />

        <ProgressBar
            android:id="@+id/seekProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="88dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:progress="50"
            android:progressTint="#FF2A3D" />
    </LinearLayout>

    <!-- SEEK BUTTONS -->
    <ImageButton
        android:id="@+id/btnSeekBack"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="32dp"
        android:background="@drawable/overlay_neon_bg"
        android:src="@drawable/ic_replay_10"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnSeekFwd"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="32dp"
        android:background="@drawable/overlay_neon_bg"
        android:src="@drawable/ic_forward_10"
        android:visibility="gone" />

    <!-- LOADING -->
    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FF2A3D" />
    </LinearLayout>

</FrameLayout>
